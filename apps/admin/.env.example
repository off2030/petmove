# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - never commit real keys.

# ─── Supabase (from https://supabase.com/dashboard) ───
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://ugywxiyivfzflqkcnqvu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Service role (server-only, never expose to browser)
# Used by import scripts and admin operations
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenAI (from https://platform.openai.com/api-keys) ───
# Used by lib/actions/extract-*.ts (flight/vaccine/address AI extraction)
OPENAI_API_KEY=

# Per-task model overrides — 선택사항. 미설정 시 lib/openai-config.ts 의 기본값 사용.
# 기본 추출(extract-extra/all): gpt-4.1
OPENAI_MODEL=
# 마약 신청서 등 drop-create 흐름
OPENAI_DROP_MODEL=
# 광견병 항체검사 추출
OPENAI_TITER_MODEL=
# 백신 증명서 추출
OPENAI_VACCINE_MODEL=

# ─── Naver OAuth (from https://developers.naver.com/apps) ───
# 자체 OAuth 처리 — Supabase builtin 미지원이라 app/api/auth/naver/* 에서 직접 코드 교환.
# Callback URL 등록: <origin>/api/auth/naver/callback
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── Kakao Address API (from https://developers.kakao.com) ───
# 도로명주소 → 영문주소 변환 (lib/kakao-address.ts). 미설정 시 변환 skip.
KAKAO_REST_API_KEY=

# ─── Web Push (VAPID) ───
# 푸시 알림 클라이언트 구독용 공개키 — 발송 인프라(web-push 라이브러리) 미구축 상태라
# 키 설정해도 실제 알림은 전달되지 않음. 발송 endpoint 도입 시 함께 활성화 예정.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ─── Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile) ───
# /apply 공개 신청폼 봇 차단. 두 키 모두 설정해야 활성화 — 미설정 시 위젯 미표시 +
# 서버측 검증 skip (dev 환경 호환).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Resend (from https://resend.com/api-keys) ───
# 초대 이메일 자동 발송. 미설정 시 링크 복사만 동작 (발송 skip).
# INVITE_EMAIL_FROM: 검증된 도메인에서의 발신 주소. 미설정 시 onboarding@resend.dev (샌드박스)
RESEND_API_KEY=
INVITE_EMAIL_FROM=

# ─── Sentry (https://sentry.io) ───
# 에러 추적. production 배포에서만 활성화 (sentry config 의 enabled 가드).
# DSN 은 클라이언트에 노출되어도 안전한 공개 값.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Vercel 빌드시 소스맵 업로드용 (server-only). https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=
