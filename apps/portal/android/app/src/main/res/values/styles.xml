<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- 상태바: 라이트 앱 배경(pm-bg 토큰)에 맞춰 배경색 + 어두운 아이콘(흰 아이콘이 안 보이던 문제 수정). -->
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- 하단 내비게이션 바: 기본 검정 대신 앱 배경(pm-bg 토큰)에 맞춤.
             - navigationBarColor: 안드로이드 14 이하에서 바 색을 직접 지정.
             - windowBackground: 안드로이드 15+(edge-to-edge 강제)에선 바가 투명해져 navigationBarColor 가
               무시되므로, 그 뒤로 비치는 창 배경을 앱 캔버스색으로 깔아 같은 색으로 보이게 한다.
             - windowLightNavigationBar: 밝은 배경 위 어두운 버튼 아이콘(15+ 에선 MainActivity 런타임으로 보강). -->
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>


    <!-- 런치 테마. Android 12+ 시스템 스플래시(아이콘+단색, OS 강제·첫 0.5초 안팎)의
         배경색은 values-v31/styles.xml 이 지정하고, 그 뒤 풀화면 시안(하늘+구름+펫무브)은
         MainActivity 의 부트 스플래시(ImageView)가 띄운다. @capacitor/splash-screen 은
         12+ 런치에서 시스템 스플래시만 유지할 뿐 풀화면 이미지를 못 띄워서(2026-07-15
         실기기 확인) 안드로이드에선 launchShowDuration=0 으로 꺼 둔다
         (apps/portal/scripts/patch-android-splash-config.mjs). -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar">
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>