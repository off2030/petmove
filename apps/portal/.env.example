# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - never commit real keys.

# ─── Supabase (from https://supabase.com/dashboard) ───
# admin 과 동일한 Seoul 프로젝트 사용. 키는 admin/.env.local 에서 그대로 복사.
NEXT_PUBLIC_SUPABASE_URL=https://ugywxiyivfzflqkcnqvu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Service role (server-only, never expose to browser)
# 공개 신청폼(/apply)·케이스 액션이 service role 로 RLS 우회.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Work(펫무브워크) 도메인 ───
# 구 share 링크(portal 도메인으로 들어온 /share/[token])를 work 도메인으로 redirect 할 때 사용.
# 미설정 시 https://work.petmove.co.kr 하드코드 폴백.
# 로컬 dev:  http://localhost:3000
# Production: https://work.petmove.co.kr
NEXT_PUBLIC_WORK_BASE_URL=http://localhost:3000

# ─── Naver OAuth (from https://developers.naver.com) ───
# admin 과 같은 네이버 앱을 공유해도 되고, portal 전용으로 새로 만들어도 됨.
# 어느 쪽이든 네이버 개발자 센터의 "Callback URL" 에
# `https://<portal-domain>/api/auth/naver/callback` 등록 필요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile) ───
# 공개 신청폼(/apply/<slug>) 봇 차단. 둘 다 비우면 위젯 미표시 + 서버 검증 스킵(graceful degrade),
# honeypot 만 동작. 활성화하려면 Turnstile site 등록 후 두 값을 채우고, site 의 도메인 화이트리스트에
# production / preview / localhost 등록. (Vercel 서버 빌드라 두 값은 Vercel 환경변수에 넣어야 함.)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
