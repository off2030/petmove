# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - never commit real keys.

# ─── Supabase (from https://supabase.com/dashboard) ───
# admin 과 동일한 Seoul 프로젝트 사용. 키는 admin/.env.local 에서 그대로 복사.
NEXT_PUBLIC_SUPABASE_URL=https://ugywxiyivfzflqkcnqvu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Service role (server-only, never expose to browser)
# share-token 진입 흐름이 service role 로 RLS 우회 (anon 사용자가 토큰만으로 진입 가능).
SUPABASE_SERVICE_ROLE_KEY=

# ─── Naver OAuth (from https://developers.naver.com) ───
# admin 과 같은 네이버 앱을 공유해도 되고, portal 전용으로 새로 만들어도 됨.
# 어느 쪽이든 네이버 개발자 센터의 "Callback URL" 에
# `https://<portal-domain>/api/auth/naver/callback` 등록 필요.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
