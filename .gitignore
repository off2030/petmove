# Dependencies
node_modules/

# Environment (never commit secrets)
.env
.env.local
.env*.local

# Supabase local dev artifacts
supabase/.temp/
supabase/.branches/

# Next.js (for when we add it)
.next/
# 검증용 dev/build 격리 산출물 (PM_DIST_DIR — apps/portal/next.config.mjs 참고)
# 세션마다 새 dist 폴더 이름을 만들기 때문에 개별 나열로는 늘 새는 자리가 생긴다
#   (2026-07-27 .next-verify2, 2026-08-04 .next-www-b 가 실제로 스테이징됐다).
# 접두사 하나로 전부 덮는다 — PM_DIST_DIR 은 항상 '.next-' 로 시작한다.
.next-*/
out/
dist/
build/

# Turbo build cache — per-package and root
.turbo/

# TypeScript incremental build cache — regenerated on every tsc run,
# causes noisy diffs and push conflicts across machines.
tsconfig.tsbuildinfo
*.tsbuildinfo

# PDF analysis/debug output from test scripts
**/data/pdf-analysis/
**/data/test-*.pdf

# Next.js auto-generated type reference — path changes per dev/build state
next-env.d.ts

# OS / Editor
.DS_Store
Thumbs.db
*.swp
*.log
.vscode/
.idea/

# npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
data/pdf-templates/test_*.pdf
.claude/

# 로컬 빌드 검증용 스크래치 복사본 (agent 도구가 만드는 경우 있음)
_buildcheck2/

# DB 백업 파일 (실수로 repo 내부에 둬도 커밋 안 되게)
backup_*.sql
backup_*.json
backup_*.csv
*_rows.csv
petmove_backup*/
storage_backup/
backups/
# 마이그 스크립트가 만드는 prod 데이터 백업(PII) — 절대 커밋 금지.
scripts/backup-bydest-*.json
scripts/backup-*.json
.vercel

# Sentry Config File
.env.sentry-build-plugin


# 파이썬 바이트코드 캐시 (scripts/ 실행 시 생김)
__pycache__/
*.pyc

# fontconfig 캐시 (이미지 생성 스크립트가 만듦)
fccache/
